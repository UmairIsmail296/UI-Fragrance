{
  "version": 2,
  "builds": [
    {
      "src": "ui-fragrance/server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "ui-fragrance/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/ui-fragrance/server/server.js"
    },
    {
      "src": "/((?!api/).*)",
      "destination": "/ui-fragrance/client/index.html"
    }
  ]
}