{
  "version": 2,
  "builds": [
    {
      "src": "ui-fragrance/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "ui-fragrance/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/ui-fragrance/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/ui-fragrance/client/dist/index.html"
    }
  ]
}