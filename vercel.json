{
  "buildCommand": "npm install --prefix ui-fragrance/client && npm run build --prefix ui-fragrance/client",
  "outputDirectory": "ui-fragrance/client/dist",
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/googlelead5c539971cfb3990.html",
      "destination": "/googlelead5c539971cfb3990.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://ui-fragrance-backend.vercel.app/sitemap.xml"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}