{
  "version": 2,
  "builds": [
    {
      "src": "ui-fragrance/server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "ui-fragrance/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "ui-fragrance/server/server.js"
    },
    {
      "src": "/(.*)",
      "destination": "/ui-fragrance/client/$1"
    }
  ]
}